{
  "expo": {
    "name": "IBRA",
    "slug": "ibra",
    "scheme": "ibra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.almershed.ibra",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك عشان نعرض لك أقرب المطاعم والكافيهات.",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول للصور عشان ترفع صور المطاعم والأطباق.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.almershed.ibra",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "config": {
        "googleMaps": {
          "apiKey": "ضع_مفتاح_خرائط_جوجل_هنا"
        }
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-dot.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك عشان نعرض لك أقرب المطاعم والكافيهات."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول للصور عشان ترفع صور المطاعم والأطباق.",
          "cameraPermission": false
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
